    <option name="pa_size" default_value="48" description="Physical address bits"/>
    <option name="vlen" default_value="512" description="Vector length"/>
    <option name="elen" default_value="64" description="Vector element length"/>
    <option name="exit_loop" default_value="1" description="Exit on terminal self-loop"/>
