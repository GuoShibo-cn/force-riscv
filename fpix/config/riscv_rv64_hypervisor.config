<?xml version="1.0" encoding="UTF-8"?>
<config>
  <simulator_options>
    <option name="max_insts" default_value="-1" description="Instruction limit"/>
    <option name="railhouse" default_value="" description="Trace path"/>
    <option name="decoding" default_value="0" description="Print decoding"/>
