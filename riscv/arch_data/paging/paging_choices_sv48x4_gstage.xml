<choices_file>

  <!-- Page Size Choices -->
  <choices name="Page size#4K granule#H#stage 2" type="Paging">
    <choice description="4K page size" name="4K" value="0x0" weight="97"/>
    <choice description="2M page size" name="2M" value="0x1" weight="2"/>
    <choice description="1G page size" name="1G" value="0x2" weight="1"/>
  </choices>
  <choices name="System Page size#4K granule#H#stage 2" type="Paging">
    <choice description="4K page size" name="4K" value="0x0" weight="100"/>
    <choice description="2M page size" name="2M" value="0x1" weight="0"/>
    <choice description="1G page size" name="1G" value="0x2" weight="0"/>
  </choices>

  <!-- Descriptor Attribute Generation Choices -->
  <!-- G-stage: no SystemPage attribute -->
  <choices name="DA#H#stage 2" type="Paging">
    <choice description="DA=0b00" name="0" value="0x0" weight="1"/>
    <choice description="DA=0b01" name="1" value="0x1" weight="100"/>
    <choice description="DA=0b10" name="2" value="0x2" weight="1"/>
    <choice description="DA=0b11" name="3" value="0x3" weight="100"/>
  </choices>
  <!-- G-stage: G bit reserved, always 0 -->
  <choices name="G#H#stage 2" type="Paging">
    <choice description="G=0" name="0" value="0x0" weight="100"/>
    <choice description="G=1" name="1" value="0x1" weight="0"/>
  </choices>
  <!-- G-stage: no U bit (guest physical addresses) -->
  <choices name="U#H#stage 2" type="Paging">
    <choice description="U=0" name="0" value="0x0" weight="100"/>
    <choice description="U=1" name="1" value="0x1" weight="0"/>
  </choices>
  <choices name="X#H#stage 2" type="Paging">
    <choice description="X=0" name="0" value="0x0" weight="10"/>
    <choice description="X=1" name="1" value="0x1" weight="10"/>
  </choices>
  <choices name="WR#H#stage 2" type="Paging">
    <choice description="no access" name="0" value="0x0" weight="10"/>
    <choice description="read access" name="1" value="0x1" weight="100"/>
    <choice description="invalid WR" name="2" value="0x2" weight="1"/>
    <choice description="readwrite access" name="3" value="0x3" weight="100"/>
  </choices>
  <choices name="V#H#stage 2" type="Paging">
    <choice description="V=0" name="0" value="0x0" weight="1"/>
    <choice description="V=1" name="1" value="0x1" weight="100"/>
  </choices>
  <!-- G-stage: RSW2 (2-bit) instead of RSW (1-bit) -->
  <choices name="RSW2#H#stage 2" type="Paging">
    <choice description="RSW2=0b00" name="0" value="0x0" weight="25"/>
    <choice description="RSW2=0b01" name="1" value="0x1" weight="25"/>
    <choice description="RSW2=0b10" name="2" value="0x2" weight="25"/>
    <choice description="RSW2=0b11" name="3" value="0x3" weight="25"/>
  </choices>

  <!-- Exception Regulation Choices -->
  <!-- Guest page faults for G-stage -->
  <choices name="InstructionPageFault#H#stage 2" type="Paging">
    <choice description="Prevent" name="Prevent" value="0x0" weight="100"/>
    <choice description="Allow" name="Allow" value="0x1" weight="0"/>
    <choice description="Trigger" name="Trigger" value="0x2" weight="0"/>
  </choices>
  <choices name="LoadPageFault#H#stage 2" type="Paging">
    <choice description="Prevent" name="Prevent" value="0x0" weight="100"/>
    <choice description="Allow" name="Allow" value="0x1" weight="0"/>
    <choice description="Trigger" name="Trigger" value="0x2" weight="0"/>
  </choices>
  <choices name="StoreAmoPageFault#H#stage 2" type="Paging">
    <choice description="Prevent" name="Prevent" value="0x0" weight="100"/>
    <choice description="Allow" name="Allow" value="0x1" weight="0"/>
    <choice description="Trigger" name="Trigger" value="0x2" weight="0"/>
  </choices>
  <choices name="InstructionAccessFault#H#stage 2" type="Paging">
    <choice description="Prevent" name="Prevent" value="0x0" weight="100"/>
    <choice description="Allow" name="Allow" value="0x1" weight="0"/>
    <choice description="Trigger" name="Trigger" value="0x2" weight="0"/>
  </choices>
  <choices name="LoadAccessFault#H#stage 2" type="Paging">
    <choice description="Prevent" name="Prevent" value="0x0" weight="100"/>
    <choice description="Allow" name="Allow" value="0x1" weight="0"/>
    <choice description="Trigger" name="Trigger" value="0x2" weight="0"/>
  </choices>
  <choices name="StoreAmoAccessFault#H#stage 2" type="Paging">
    <choice description="Prevent" name="Prevent" value="0x0" weight="100"/>
    <choice description="Allow" name="Allow" value="0x1" weight="0"/>
    <choice description="Trigger" name="Trigger" value="0x2" weight="0"/>
  </choices>
  <choices name="InstructionGuestPageFault#H#stage 2" type="Paging">
    <choice description="Prevent" name="Prevent" value="0x0" weight="100"/>
    <choice description="Allow" name="Allow" value="0x1" weight="0"/>
    <choice description="Trigger" name="Trigger" value="0x2" weight="0"/>
  </choices>
  <choices name="LoadGuestPageFault#H#stage 2" type="Paging">
    <choice description="Prevent" name="Prevent" value="0x0" weight="100"/>
    <choice description="Allow" name="Allow" value="0x1" weight="0"/>
    <choice description="Trigger" name="Trigger" value="0x2" weight="0"/>
