  </choices>
  <choices name="Invalid V#level 3#H#stage 2" type="Paging">
    <choice description="Don't check" name="0" value="0x0" weight="100"/>
    <choice description="Check" name="1" value="0x1" weight="0"/>
  </choices>
  <choices name="Invalid DA#level 0#H#stage 2" type="Paging">
    <choice description="Don't check" name="0" value="0x0" weight="100"/>
    <choice description="Check" name="1" value="0x1" weight="0"/>
  </choices>
