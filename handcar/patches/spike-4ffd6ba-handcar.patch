+void mmu_t::declare_sparse_memory(reg_t addr, size_t len)
+{
+  if (!len || len - 1 > UINT64_MAX - addr)
+    throw std::invalid_argument("invalid sparse memory range");
+  reg_t end = addr + len - 1;
+  auto it = _sparse_ranges.lower_bound(addr);
+  if (it != _sparse_ranges.begin()) {
+    auto prev = std::prev(it);
+    if (prev->second >= addr - (addr != 0)) it = prev;
+  }
+  while (it != _sparse_ranges.end() && it->first <= end + (end != UINT64_MAX)) {
+    addr = std::min(addr, it->first);
+    end = std::max(end, it->second);
+    it = _sparse_ranges.erase(it);
+  }
+  _sparse_ranges[addr] = end;
+}
+
+bool mmu_t::sparse_backed(reg_t addr, size_t len) const
+{
+  if (!len || len - 1 > UINT64_MAX - addr) return false;
+  auto it = _sparse_ranges.upper_bound(addr);
+  return it != _sparse_ranges.begin() && std::prev(it)->second >= addr + len - 1;
+}
+
+bool mmu_t::physical_read(reg_t addr, size_t len, uint8_t* bytes, access_type type)
+{
+  if (!bytes || !len || len - 1 > UINT64_MAX - addr) return false;
+  // Host RAM has one backing store: external partial writes update it directly.
+  if (auto host = sim->addr_to_mem(addr)) {
+    for (size_t i = 0; i < len; i++)
+      if (sim->addr_to_mem(addr + i) != host + i) return false;
+    memcpy(bytes, host, len);
+    return true;
+  }
+  if (sparse_backed(addr, len)) {
+    sparse_read_partially_initialized(addr, len, bytes);
+    return true;
+  }
+  return type == FETCH ? mmio_fetch(addr, len, bytes) : mmio_load(addr, len, bytes);
+}
+
+bool mmu_t::physical_write(reg_t addr, size_t len, const uint8_t* bytes)
+{
+  if (!bytes || !len || len - 1 > UINT64_MAX - addr) return false;
+  if (auto host = sim->addr_to_mem(addr)) {
+    for (size_t i = 0; i < len; i++)
+      if (sim->addr_to_mem(addr + i) != host + i) return false;
+    memcpy(host, bytes, len);
+    return true;
+  }
+  if (sparse_backed(addr, len)) {
+    for (size_t i = 0; i < len; i++) _sparse_mem[addr + i] = bytes[i];
+    return true;
+  }
+  // Device rejection must not create a sparse overlay or a successful callback.
+  return mmio_store(addr, len, bytes);
+}
+
+void mmu_t::sparse_write(reg_t addr, const uint8_t* bytes, size_t len)
+{
+  if (!physical_write(addr, len, bytes))
+    throw std::runtime_error("physical memory write rejected");
+}
+
+uint64_t mmu_t::sparse_read(reg_t addr, size_t len)
+{
+  assert(len <= sizeof(uint64_t));
+  uint64_t result = 0;
+  uint8_t bytes[sizeof(result)];
+  if (!physical_read(addr, len, bytes))
+    throw std::runtime_error("physical memory read rejected");
+  for (size_t i = 0; i < len; i++) result |= uint64_t(bytes[i]) << (i * 8);
+  return result;
+}
+
+void mmu_t::sparse_read_partially_initialized(reg_t addr, size_t len, uint8_t* bytes)
+{
+  for (size_t i = 0; i < len; i++) {
+    auto it = _sparse_mem.find(addr + i);
+    bytes[i] = it != _sparse_mem.end() ? it->second : 0;
+  }
+}
+
+bool mmu_t::sparse_is_pa_initialized(reg_t addr, size_t len)
+{
+  for (size_t i = 0; i < len; i++)
+    if (_sparse_mem.find(addr + i) == _sparse_mem.end())
+      return false;
+  return true;
+}
+
+void mmu_t::sparse_initialize_pa(reg_t addr, uint64_t data, size_t len)
+{
+  assert(len <= sizeof(data));
+  uint8_t bytes[sizeof(data)];
+  for (size_t i = 0; i < len; i++)
+    bytes[i] = (data >> (i * 8)) & 0xff;
+  sparse_write(addr, bytes, len);
+  flush_tlb();
+}
+
+void mmu_t::sparse_reserve(reg_t addr, size_t len) { _reserved_ranges.insert({addr, len}); }
+void mmu_t::sparse_unreserve(reg_t addr, size_t len) { _reserved_ranges.erase({addr, len}); }
+bool mmu_t::sparse_is_reserved(reg_t addr, size_t len) { return _reserved_ranges.count({addr, len}) > 0; }
+
+int mmu_t::translate_api(reg_t addr, reg_t* paddr, uint64_t* pmp_info, reg_t len, access_type type, uint32_t xlate_flags)
+{
+  // Packed legacy PMP attributes are unsupported; never return invented attributes.
+  if (pmp_info) return 9; // Unsupported attribute output (distinct from legacy fault codes).
+  if (!len || len - 1 > UINT64_MAX - addr ||
+      (type != LOAD && type != STORE && type != FETCH) || (xlate_flags & ~3u)) return 1;
+  try {
+    auto info = generate_access_info(addr, type,
+      {.forced_virt=bool(xlate_flags & 3), .hlvx=bool(xlate_flags & 2)});
+    reg_t pa = translate(info, len);
+    if (paddr) *paddr = pa;
+    return 0;
+  } catch (trap_t&) {
+    return 3 + (int)type;
+  }
+}
+
+int mmu_t::walk_api(reg_t addr, reg_t* paddr, access_type type, reg_t prv, bool virt, bool hlvx)
+{
+  try {
+    mem_access_info_t info{addr, addr, prv, virt, {.forced_virt=virt, .hlvx=hlvx}, type};
+    reg_t pa = walk(info) | (addr & (PGSIZE - 1));
+    if (paddr) *paddr = pa;
+    return 0;
+  } catch (trap_t&) {
+    return 3 + (int)type;
+  }
+}
+
+bool mmu_t::pmp_ok_api(reg_t addr, reg_t* pmpaddr, uint8_t* pmpcfg, reg_t len, access_type type, reg_t mode)
+{
+  if (pmpaddr || pmpcfg)
+    throw std::invalid_argument("legacy PMP attribute outputs are unsupported");
+  return pmp_ok(addr, len, type, mode, false);
+}
