+static processor_t* core_for_target(int target_id) {
+    return _pSimulator && target_id == 0 ? _pSimulator->get_core(0) : nullptr;
+}
+
+// Only external FORCE initialization declares new sparse backing. Never shadow devices.
+static void declare_force_memory(mmu_t* mmu, reg_t addr, size_t len) {
+    for (auto [base, dev] : _pSimulator->get_bus().get_devices()) {
+        if (!dev->size()) continue;
+        bool overlaps = addr >= base ? addr - base < dev->size() : base - addr < len;
+        if (overlaps && !dynamic_cast<sparse_mem_t*>(dev)) return;
+    }
+    mmu->declare_sparse_memory(addr, len);
+}
