<?xml version="1.0" encoding="UTF-8"?>
<config_file>
  <!-- Explicit misaligned support; all paging and instruction settings come from the base. -->
  <simulator_shared_object file="utils/handcar/handcar_cosim.so"/>
  <!-- Match the FPIX Hypervisor ISA, including V for consistent CSR WARL fields. -->
  <simulator_config_string value="--isa=RV64IMAFDCVH_zfh_zicntr_zihpm_zicclsm"/>
  <import_files>
    <import_file file="config/riscv_rv64_twostage.config"/>
  </import_files>
</config_file>
